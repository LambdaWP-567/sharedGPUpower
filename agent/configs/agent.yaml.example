backend:
  endpoint: "grpc.sharedgpupower.example.com:443"
  # tls_cert: "~/.sharedgpu/agent.crt"
  # tls_key:  "~/.sharedgpu/agent.key"
  insecure: false   # set true for local development

resources:
  cpu_percent: 50     # max 50% CPU for jobs
  ram_percent: 25     # max 25% RAM
  gpu_layers: 20      # Ollama num_gpu_layers limit

ollama:
  host: "http://localhost:11434"
  default_model: "llama3.2:3b"

agent:
  name: "my-mac-studio"   # human-readable name shown in dashboard
